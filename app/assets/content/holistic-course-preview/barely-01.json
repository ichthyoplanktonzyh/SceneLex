    {
      "id": "step-08-activate-almost",
      "stage": "learning_flow",
      "trigger": "immediate_followup",
      "primitive": "l1_confirmation",
      "purpose": "在边界对照前，用 L1 确认学习者已掌握 almost（几乎、差一点）这一前置对照词；不把 almost 作为新词绑定，只确认旧知识可用。",
      "addresses": [
        "misc-1"
      ],
      "timing": null,
      "scaffold_level": null,
      "estimated_seconds": 30,
      "can_pause_after": true,
      "due_after_days": null,
      "content": {
        "prompt_text": "下一题会请你比较 barely 和 almost 两个词。almost 是你已经认识的英语词，表示“几乎、差一点”：59 分就是 almost passed（差一点及格，但没及格）。barely 是刚学的词，表示“刚刚达到，结果成立”：61 分就是 barely passed。请确认你已准备好区分“差一点没达到”和“刚刚达到”。"
      },
      "evaluation": {
        "kind": "none"
      }
    },
    {
      "id": "step-09-boundary-almost",
      "stage": "learning_flow",
      "trigger": "immediate_followup",
      "primitive": "boundary_choice",
      "purpose": "用 almost 对照，把'结果是否成立'变为两种符号的选择。",
