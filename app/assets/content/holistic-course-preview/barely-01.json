{
  "schema_version": "1.0",
  "course_id": "barely-01-course-v1",
  "target": {
    "sense_id": "barely-01",
    "lemma": "barely",
    "pos": "adverb",
    "ipa": "/ˈbɛrli/",
    "learner_l1": "zh-CN",
    "target_l2": "en"
  },
  "author_intent": {
    "course_thesis": "barely 的核心不是'没有'，而是'只高出下限一点点且结果仍然成立'；它与 almost 的差别就在阈值是否被越过。",
    "learner_start": "学习者来自 zh-CN，熟悉'几乎'、'勉强'、'刚刚'等中文表达；容易把'几乎及格'理解成没及格，也容易把'刚刚'当成时间词。此时尚未掌握 barely 的形式，但已认识 almost 作为常见前置词汇；本课只在边界对照中激活 almost，不完整教学 almost。",
    "intended_outcome": "学习者在看到'刚过线但只超一点点'的场景时能识别和产出 barely，能区分 barely passed 与 almost passed，不会把 barely visible 理解为完全不可见，也不会把 barely 当作 just now 或 reluctantly。",
    "design_rationale": "先用无需语言的阈值经验建立'最低正量'和'刚过及格线'，再绑定 barely；随后用一条 l1_confirmation 激活卡把学习者已掌握的对照词 almost 带出，再用边界题强化结果是否成立；随后做两个 L1 干扰点迁移；复习按核心场景 recall → 听感/赶车/盐量等迁移递进。"
  },
  "steps": [
    {
      "id": "step-01-fog",
      "stage": "learning_flow",
      "trigger": "initial",
      "primitive": "scene_observation",
      "purpose": "先用视觉场景让学习者体验'极低正量'：对象存在但程度接近零。",
      "addresses": [
        "misc-2"
      ],
      "timing": null,
      "scaffold_level": null,
      "estimated_seconds": 35,
      "can_pause_after": false,
      "due_after_days": null,
      "content": {
        "episode": "清晨有雾。你站在海边望向远处，灯塔只剩一个很淡的轮廓。它不是完全看不见，只是需要眯起眼睛，才能从灰白的雾里辨出那个形状。"
      },
      "evaluation": {
        "kind": "none"
      }
    },
    {
      "id": "step-02-fog-check",
      "stage": "learning_flow",
      "trigger": "immediate_followup",
      "primitive": "binary_judgment",
      "purpose": "把'最低正量'变成一次明确判断：能看到，而不是零。",
      "addresses": [
        "misc-2"
      ],
      "timing": null,
      "scaffold_level": null,
      "estimated_seconds": 30,
      "can_pause_after": false,
      "due_after_days": null,
      "content": {
        "episode": "还是同一片雾中的灯塔。视力正常的人停下脚步，眯眼看了两秒，确认那里有一座灯塔。",
        "evidence": [
          "灯塔在画面里只有一个淡轮廓。",
          "那个轮廓需要仔细看，但确实可以被认出来。"
        ],
        "question": "灯塔到底能不能被看到？",
        "options": [
          {
            "id": "visible",
            "text": "能看到，虽然只是淡淡的轮廓",
            "feedback": "对。它离'看不见'非常近，但仍然看得见。"
          },
          {
            "id": "invisible",
            "text": "不能看到，完全隐没在雾里",
            "feedback": "如果完全看不见，那是零程度，不是这里的情况。"
          }
        ]
      },
      "evaluation": {
        "kind": "choice",
        "correct_option_id": "visible"
      }
    },
    {
      "id": "step-03-score-scale",
      "stage": "learning_flow",
      "trigger": "immediate_followup",
      "primitive": "scalar_threshold",
      "purpose": "用可拖动的分数标尺建立'越过合格线但只超出一点点'的阈值经验。",
      "addresses": [
        "misc-1"
      ],
      "timing": null,
      "scaffold_level": null,
      "estimated_seconds": 60,
      "can_pause_after": true,
      "due_after_days": null,
      "content": {
        "episode": "一门考试满分100，及格线是60。小华的成绩单上是61分；小李的成绩单上是59分。拖动标尺分别停在61和59，看看结果标签的变化。",
        "scale": {
          "min": 0,
          "max": 100,
          "label": "分数"
        },
        "initial_value": 61,
        "threshold": 60,
        "direction": "reaches",
        "outcome_markers": {
          "reached": "已经达到（只高出一点）",
          "not_reached": "未达到（还差一点）"
        },
        "question": "哪一个更贴合'刚刚达到及格线'？",
        "options": [
          {
            "id": "hua_61",
            "text": "小华：61分，只高出及格线1分",
            "feedback": "对。61分已经越过及格线，而且只高出一点点。"
          },
          {
            "id": "li_59",
            "text": "小李：59分，还差1分没到线",
            "feedback": "59分还没越过及格线。它离线很近，但不是'刚刚达到'。"
          }
        ]
      },
      "evaluation": {
        "kind": "choice",
        "correct_option_id": "hua_61"
      }
    },
    {
      "id": "step-04-symbol",
      "stage": "learning_flow",
      "trigger": "immediate_followup",
      "primitive": "symbol_reveal",
      "purpose": "首次揭示目标词 barely 的拼写、发音与最小 L1 确认。",
      "addresses": [],
      "timing": null,
      "scaffold_level": null,
      "estimated_seconds": 50,
      "can_pause_after": true,
      "due_after_days": null,
      "content": {
        "l2_word": "barely",
        "ipa": "/ˈbɛrli/",
        "presentation": "刚才的灯塔和61分都在描述同一种程度：它比'零'或'及格线'只高一点点，但事情仍然成立。英语里用这个词来表达这种'勉强、刚刚够到'的程度。",
        "minimal_l1_gloss": "勉强、几乎不"
      },
