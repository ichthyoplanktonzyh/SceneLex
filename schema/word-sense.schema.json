{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "word-sense.schema.json",
  "title": "WordSense",
  "description": "SceneLex 词义对象 — 语义内核的基本单位。ID 约定: {word}-{nn}, 如 reluctant-01, run-03。schema_version 1.1 起, WordSense 是某个 approved Sense Inventory sense 的详细规格, 必须携带 inventory provenance 与锁定的语义身份; 1.0 是 inventory 层出现之前的历史资源, 不强制这些字段。",
  "type": "object",
  "required": ["schema_version", "language", "version", "status", "id", "word", "pos", "sense_label", "semantic_type", "semantic_skeleton", "conditions"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": "1.1" } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["inventory", "semantic_identity", "inventory_source_entries"]
      }
    }
  ],
  "properties": {

    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.1"],
      "description": "1.0: inventory 层之前的历史资源; 1.1: 由 approved Sense Inventory 驱动生成, 必须包含 inventory / semantic_identity / inventory_source_entries"
    },

    "inventory": {
      "type": "object",
      "required": ["word", "version", "evidence_digest", "sense_id", "identity_digest"],
      "additionalProperties": false,
      "description": "本义项所依据的 approved Sense Inventory 溯源; 由 tools/draft.py 程序化写入, 模型输出的值一律被覆盖",
      "properties": {
        "word": {
          "type": "string",
          "minLength": 1,
          "description": "必须与顶层 word 一致 (由 Python validator 检查)"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "必须等于 approved inventory 的 inventory_version"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "必须等于 approved inventory 的 source.evidence_digest"
        },
        "sense_id": {
          "type": "string",
          "pattern": "^[a-z][a-z_]*-[0-9]{2}$",
          "description": "必须等于顶层 id"
        },
        "identity_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "对 inventory sense 的锁定身份字段 (id/lemma/pos/semantic_signature) 计算的确定性摘要; 不含 definition、label_zh 等自由文本, 文字润色不改变身份"
        }
      }
    },

    "semantic_identity": {
      "type": "object",
      "required": ["semantic_type", "dimension", "change_of_state", "causative", "valency"],
      "additionalProperties": false,
      "description": "从 approved inventory sense 的 semantic_signature 逐字复制的锁定语义身份, 供确定性比较; 与顶层 semantic_type (决定场景策略的窄枚举) 是不同的字段, 不可互相替代",
      "properties": {
        "semantic_type": { "type": "string", "minLength": 1 },
        "dimension": { "type": ["string", "null"] },
        "change_of_state": { "type": "boolean" },
        "causative": { "type": "boolean" },
        "valency": { "type": "string", "minLength": 1 }
      }
    },

    "inventory_source_entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "必须与 approved inventory sense 的 source_entries 集合完全一致, 不能增删。uniqueItems 防止 [\"x\", \"x\"] 这类重复条目因为按集合比较而被当成合法的精确映射"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$",
      "description": "本义项所属语言的 ISO 639 代码"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "该稳定义项 ID 下的内容版本"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "published", "deprecated"]
    },

    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*-[0-9]{2}$",
      "description": "唯一义项标识符: {word}-{nn}"
    },
    "word": {
      "type": "string"
    },
    "pos": {
      "type": "string",
      "enum": ["noun", "verb", "adjective", "adverb", "preposition", "conjunction", "determiner", "pronoun", "interjection", "particle"]
    },
    "sense_label": {
      "type": "string",
      "description": "义项的简短中文标签，供内部使用"
    },
    "definition": {
      "type": "string",
      "description": "简明英文定义，供内部参考"
    },

    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "band": {
          "type": "string",
          "enum": ["core", "high", "mid", "low"],
          "description": "core: 前500; high: 500-1500; mid: 1500-3500; low: 3500+"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "description": "在通用词频表(如COCA)中的大致排名"
        }
      }
    },
    "difficulty": {
      "type": "string",
      "enum": ["basic", "intermediate", "advanced"],
      "description": "语义习得难度，不等于词频"
    },
    "pronunciation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipa": { "type": "string" },
        "audio_ref": { "type": "string" }
      }
    },
    "collocations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "高频搭配和固定短语"
    },
    "sentence_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "常见句法结构，使用占位符标记: [verb], [noun], [adj]"
    },

    "semantic_type": {
      "type": "string",
      "enum": [
        "entity",
        "action",
        "attribute",
        "state_change",
        "spatial_relation",
        "temporal_relation",
        "scalar_degree",
        "mental_state",
        "intentional_behavior",
        "causal_logic",
        "cognitive_change",
        "discourse_function"
      ],
      "description": "按'意义如何被感知'分类，决定场景设计策略"
    },

    "semantic_skeleton": {
      "type": "object",
      "required": ["propositions"],
      "additionalProperties": false,
      "description": "词义的深层语义假设 — 与具体渲染解耦，可跨场景和跨文化检验",
      "properties": {
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "description"],
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "description": "语义角色标签，如 agent, experiencer, stimulus"
              },
              "description": { "type": "string" }
            }
          }
        },
        "propositions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "description": "有序的语义条件列表，共同定义该义项的成立"
        }
      }
    },

    "conditions": {
      "type": "object",
      "required": ["required", "excluded"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "该义项成立的必要条件"
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["condition"],
            "additionalProperties": false,
            "properties": {
              "condition": {
                "type": "string",
                "description": "排除该义项的情况"
              },
              "alternative": {
                "type": "string",
                "description": "此情况下可能适用的其他义项ID"
              }
            }
          },
          "description": "排除条件及可能的替代义项"
        }
      }
    },

    "relations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "synonyms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "近义义项ID"
        },
        "antonyms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "hypernyms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "上位义项ID"
        },
        "hyponyms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "下位义项ID"
        },
        "confusables": {
          "type": "array",
          "items": { "type": "string" },
          "description": "容易与之混淆的义项ID"
        },
        "boundaries": {
          "type": "array",
          "description": "可验证的词义边界；显式表达互斥、包含或重叠，不能把近义词一律当成互斥分类",
          "items": {
            "type": "object",
            "required": ["target", "relation", "distinction", "diagnostic"],
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^[a-z][a-z_]*-[0-9]{2}$"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "mutually_exclusive",
                  "overlaps",
                  "target_more_specific",
                  "target_more_general",
                  "degree_neighbor",
                  "different_dimension",
                  "different_sense"
                ]
              },
              "distinction": {
                "type": "string",
                "description": "两个义项的区别轴及可能重叠关系"
              },
              "diagnostic": {
                "type": "string",
                "description": "可由场景或语境验证的判据"
              }
            }
          }
        },
        "l1_confusables": {
          "type": "object",
          "description": "L1 特定的混淆模式，按 ISO 639-1 语言代码索引",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["l1_term", "covers"],
              "additionalProperties": false,
              "properties": {
                "l1_term": {
                  "type": "string",
                  "description": "导致混淆的L1词汇"
                },
                "covers": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "该L1词汇覆盖的L2义项ID列表"
                },
                "note": {
                  "type": "string",
                  "description": "概念边界差异的说明"
                }
              }
            }
          }
        }
      }
    },

    "scene_requirements": {
      "type": "object",
      "additionalProperties": false,
      "description": "该义项被场景表达时的约束",
      "properties": {
        "must_show": {
          "type": "array",
          "items": { "type": "string" },
          "description": "场景必须呈现的元素"
        },
        "must_not": {
          "type": "array",
          "items": { "type": "string" },
          "description": "场景必须避免的元素"
        },
        "externalization": {
          "type": "array",
          "items": { "type": "string" },
          "description": "内部/抽象状态的外化手段"
        },
        "timing": {
          "type": "string",
          "description": "目标表达相对于场景事件的出现时机"
        }
      }
    },

    "provenance": {
      "type": "object",
      "description": "支持词义分析的可追溯来源；published 资源应填写",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "citation"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["dictionary", "corpus", "research", "expert_review", "other"]
              },
              "citation": { "type": "string" },
              "license": { "type": "string" }
            }
          }
        },
        "reviewed_by": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
