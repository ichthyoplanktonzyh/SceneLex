{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenelex.org/schema/image-render-source-packet.schema.json",
  "title": "SceneLex Image Render Source Packet",
  "description": "LLM Visual Compiler 的确定性输入 Data Packet 规格。禁止写入 API Key、Base64 或临时 URL。",
  "type": "object",
  "required": [
    "schema_version",
    "scene_ref",
    "keyframe_id",
    "source_refs",
    "image_roles",
    "target",
    "source_state",
    "scene_constants",
    "render_context"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "scene_ref": { "type": "string", "minLength": 1 },
    "keyframe_id": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "object",
      "required": ["shot_plan_version", "keyframe_plan_version", "source_image_version"],
      "additionalProperties": false,
      "properties": {
        "shot_plan_version": { "type": "integer", "minimum": 1 },
        "keyframe_plan_version": { "type": "integer", "minimum": 1 },
        "source_image_version": { "type": "integer", "minimum": 1 }
      }
    },
    "image_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "path"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["identity_reference", "base_image", "previous_keyframe_pass"] },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["visual_state", "must_show", "must_avoid"],
      "additionalProperties": false,
      "properties": {
        "visual_state": { "type": "string" },
        "must_show": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^show-[0-9]{2}$" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "must_avoid": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^avoid-[0-9]{2}$" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "source_state": {
      "type": "object",
      "required": ["previous_keyframe_id", "previous_visual_state", "continuity_from_previous"],
      "additionalProperties": false,
      "properties": {
        "previous_keyframe_id": { "type": ["string", "null"] },
        "previous_visual_state": { "type": ["string", "null"] },
        "continuity_from_previous": { "type": ["string", "null"] }
      }
    },
    "scene_constants": {
      "type": "object",
      "required": ["cast", "location", "props"],
      "additionalProperties": false,
      "properties": {
        "cast": { "type": "array", "items": { "type": "string" } },
        "location": { "type": ["string", "null"] },
        "props": { "type": "array", "items": { "type": "string" } }
      }
    },
    "render_context": {
      "type": "object",
      "required": ["provider", "model", "requested_size"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "requested_size": { "type": "string", "minLength": 1 }
      }
    }
  }
}
