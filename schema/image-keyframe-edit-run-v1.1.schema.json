{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenelex.org/schema/image-keyframe-edit-run-v1.1.schema.json",
  "title": "SceneLex Image Keyframe Edit Run v1.1",
  "description": "SceneLex 状态编辑实验记录 v1.1 规格，分离 VLM 多模态辅助审核与 Human 最终 Gate。禁止写入 API Key、Base64 或临时 URL。",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "status",
    "scene_ref",
    "shot_plan_ref",
    "keyframe_plan_ref",
    "source_image_keyframe_ref",
    "api_gate",
    "semantic_gate",
    "generation",
    "identity_reference",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.1" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "reviewed"] },
    "scene_ref": { "type": "string", "minLength": 1 },
    "shot_plan_ref": { "$ref": "#/$defs/planRef" },
    "keyframe_plan_ref": { "$ref": "#/$defs/planRef" },
    "source_image_keyframe_ref": { "$ref": "#/$defs/planRef" },
    "api_gate": {
      "enum": ["pending", "pass", "blocked"],
      "description": "历史字段名，实际表示本次 Edit Run 的生成执行门：全部 target 都绑定 generated selected_attempt 才是 pass；存在记录化失败且未全通过是 blocked；其余是不完整但未阻塞的 pending。不得用裸图片文件推断。"
    },
    "semantic_gate": {
      "enum": ["pending", "pass", "revision_required", "not_run"],
      "description": "从 selected attempts 的 Human Reviews 确定性推导：无绑定候选是 not_run；存在 weak/fail 是 revision_required；全部 target 生成覆盖且全部人工维度 pass 才是 pass；其余是 pending。VLM 不参与推导。"
    },
    "generation": {
      "type": "object",
      "required": ["protocol", "endpoint_kind", "primary_model", "fallback_model", "requested_size", "watermark"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "const": "aliyun-token-plan" },
        "endpoint_kind": { "type": "string", "minLength": 1 },
        "primary_model": { "type": "string", "minLength": 1 },
        "fallback_model": { "type": "string", "minLength": 1 },
        "requested_size": { "type": "string", "minLength": 1 },
        "watermark": { "const": false },
        "generated_at": { "type": ["string", "null"] }
      }
    },
    "identity_reference": {
      "type": "object",
      "required": ["image", "rationale", "scope"],
      "additionalProperties": false,
      "properties": {
        "image": { "type": ["string", "null"] },
        "rationale": { "type": ["string", "null"] },
        "scope": { "enum": ["experiment-local", null] }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["keyframe_id", "source_image", "identity_reference", "attempts", "selected_attempt"],
        "additionalProperties": false,
        "properties": {
          "keyframe_id": { "type": "string", "minLength": 1 },
          "source_image": { "type": ["string", "null"] },
          "identity_reference": { "type": ["string", "null"] },
          "attempts": {
            "type": "array",
            "items": { "$ref": "#/$defs/attempt" }
          },
          "selected_attempt": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "planRef": {
      "type": "object",
      "required": ["scene_id", "version"],
      "additionalProperties": false,
      "properties": {
        "scene_id": { "type": "string", "minLength": 1 },
        "version": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "attempt": {
      "type": "object",
      "required": ["attempt", "model", "prompt", "image", "request_id", "seed", "bbox_list", "status", "reviews"],
      "additionalProperties": false,
      "properties": {
        "attempt": { "type": "string", "pattern": "^attempt-[0-9]{2}$" },
        "model": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "image": { "type": ["string", "null"] },
        "request_id": { "type": ["string", "null"] },
        "seed": { "type": "integer" },
        "bbox_list": {
          "type": ["array", "null"]
        },
        "status": { "enum": ["pending", "generated", "failed"] },
        "render_directive_ref": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "keyframe_id": { "type": "string" },
            "compiler_attempt": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "reviews": {
          "type": "object",
          "required": ["vlm", "human"],
          "additionalProperties": false,
          "properties": {
            "vlm": {
              "type": "object",
              "required": ["status", "protocol", "model", "request_id", "generated_at", "suggested_verdict", "verdicts", "findings", "notes"],
              "additionalProperties": false,
              "properties": {
                "status": { "enum": ["pending", "completed", "failed"] },
                "protocol": { "type": ["string", "null"] },
                "model": { "type": ["string", "null"] },
                "request_id": { "type": ["string", "null"] },
                "generated_at": { "type": ["string", "null"] },
                "suggested_verdict": { "enum": ["pending", "pass", "revision_required", null] },
                "verdicts": { "$ref": "#/$defs/verdictSet" },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["criterion_id", "verdict", "evidence"],
                    "additionalProperties": false,
                    "properties": {
                      "criterion_id": { "type": "string" },
                      "verdict": { "$ref": "#/$defs/verdict" },
                      "evidence": { "type": "string" }
                    }
                  }
                },
                "notes": { "type": "array", "items": { "type": "string" } }
              }
            },
            "human": {
              "type": "object",
              "required": ["status", "reviewer", "reviewed_at", "verdicts", "notes"],
              "additionalProperties": false,
              "properties": {
                "status": { "enum": ["pending", "completed"] },
                "reviewer": { "type": ["string", "null"] },
                "reviewed_at": { "type": ["string", "null"] },
                "verdicts": { "$ref": "#/$defs/verdictSet" },
                "notes": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "http_status": { "type": ["integer", "null"] },
            "message": { "type": ["string", "null"] }
          }
        }
      }
    },
    "verdictSet": {
      "type": "object",
      "required": ["semantic_readability", "state_fidelity", "character_consistency", "prop_continuity", "composition"],
      "additionalProperties": false,
      "properties": {
        "semantic_readability": { "$ref": "#/$defs/verdict" },
        "state_fidelity": { "$ref": "#/$defs/verdict" },
        "character_consistency": { "$ref": "#/$defs/verdict" },
        "prop_continuity": { "$ref": "#/$defs/verdict" },
        "composition": { "$ref": "#/$defs/verdict" }
      }
    },
    "verdict": { "enum": ["pending", "pass", "weak", "fail"] }
  }
}
