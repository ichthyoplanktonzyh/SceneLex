{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene-spec.schema.json",
  "title": "SceneSpec",
  "description": "场景规格 — 场景编译器的输出，描述一个完整的教学场景",
  "type": "object",
  "required": ["schema_version", "version", "status", "id", "sense_ref", "scene_type", "title", "synopsis", "storyboard", "learning_tasks"],
  "additionalProperties": false,
  "properties": {

    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "published", "deprecated"]
    },

    "id": {
      "type": "string",
      "description": "场景ID: {sense_id}-{type_abbr}-{nn}, 如 reluctant-01-proto-01"
    },
    "sense_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*-[0-9]{2}$",
      "description": "本场景教授的义项ID"
    },
    "scene_type": {
      "type": "string",
      "enum": ["prototype", "contrast", "boundary", "counterexample", "transfer"],
      "description": "prototype=原型; contrast=对比; boundary=边界; counterexample=反例; transfer=迁移"
    },
    "contrast_target": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*-[0-9]{2}$",
      "description": "对比/边界/反例场景中被对比或被指向的替代义项ID"
    },

    "title": {
      "type": "string",
      "description": "场景标题，简短描述场景"
    },
    "synopsis": {
      "type": "string",
      "description": "场景概要，一段话描述事件和人物"
    },

    "target_learner": {
      "type": "object",
      "additionalProperties": false,
      "description": "本场景适用的学习者特征",
      "properties": {
        "l1": { "type": "string" },
        "life_context": {
          "type": "string",
          "description": "目标生活场景，如 office, campus, home"
        }
      }
    },

    "contrast_relation": {
      "type": "string",
      "enum": [
        "mutually_exclusive",
        "overlaps",
        "target_more_specific",
        "target_more_general",
        "degree_neighbor",
        "different_dimension",
        "different_sense"
      ],
      "description": "与 contrast_target 的真实逻辑关系，避免把所有对比写成互斥"
    },

    "transfer_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "迁移场景相对原型改变的表面维度；transfer 至少两个"
    },

    "surface": {
      "type": "object",
      "required": ["domain", "participant_type", "setting"],
      "additionalProperties": false,
      "description": "场景的表面特征，用于检验同义项同类型多场景之间的泛化多样性；小写 kebab-case 短语",
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "生活/活动领域，如 household-chores, digital-work, sports"
        },
        "participant_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "主要参与者类型，如 adult, child, animal, crowd"
        },
        "setting": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "空间环境，如 indoor-home, outdoor-street, classroom"
        }
      }
    },

    "teaching_evidence": {
      "type": "array",
      "description": "场景中可观察线索对词义命题或边界判断的支持关系",
      "items": {
        "type": "object",
        "required": ["claim", "beats"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "beats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },

    "storyboard": {
      "type": "array",
      "minItems": 2,
      "description": "场景分镜——按时间顺序排列的叙事节拍",
      "items": {
        "type": "object",
        "required": ["beat", "visual", "purpose"],
        "additionalProperties": false,
        "properties": {
          "beat": {
            "type": "integer",
            "minimum": 1,
            "description": "节拍序号"
          },
          "visual": {
            "type": "string",
            "description": "画面描述——观众看到什么"
          },
          "audio": {
            "type": ["string", "null"],
            "description": "对话、旁白或音效; null 表示静默"
          },
          "purpose": {
            "type": "string",
            "description": "这个节拍对建立词义理解的作用"
          }
        }
      }
    },

    "learning_tasks": {
      "type": "array",
      "minItems": 1,
      "description": "场景结束后的学习任务",
      "items": {
        "type": "object",
        "required": ["type", "prompt"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "scene_recognition",
              "contrast_choice",
              "listen_and_match",
              "produce",
              "transfer_judgment"
            ],
            "description": "scene_recognition=从多场景中选; contrast_choice=辨别近义词; listen_and_match=听音选场景; produce=看场景说表达; transfer_judgment=新场景判断是否适用"
          },
          "prompt": {
            "type": "string",
            "description": "呈现给学习者的任务指令"
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" },
            "description": "可执行选择题的选项或资源引用"
          },
          "expected_answer": {
            "type": ["string", "array"],
            "items": { "type": "string" },
            "description": "机器可评分任务的标准答案；开放输出任务可不填"
          },
          "scoring_note": {
            "type": "string",
            "description": "开放输出任务的人工或模型评分标准"
          }
        }
      }
    }
  }
}
