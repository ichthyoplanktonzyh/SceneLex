{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenelex.org/schema/director-prompt.schema.json",
  "title": "SceneLex Director Prompt",
  "description": "LEGACY — 旧的模型提示词原型契约：把语义场景直接翻译为目标视频能力的提示词。历史产物继续保留，但已不是新架构的权威层：新主线是 schema/shot-plan.schema.json（Scene → Shot Plan），最终模型提示词属于 Shot Plan 下游的渲染适配层。内部草稿契约，不属于公开语义资源。",
  "type": "object",
  "required": [
    "schema_version",
    "scene_ref",
    "spec_version",
    "version",
    "status",
    "profile",
    "style",
    "strategy",
    "semantic_guardrails",
    "video_prompts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "scene_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*-[0-9]{2}-(proto|contrast|counter|boundary|transfer)-[0-9]{2}$"
    },
    "spec_version": { "type": "integer", "minimum": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "const": "draft" },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "用于编译提示词的视频能力配置标识；不是语义资源字段"
    },
    "style": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "渲染层全局风格配置标识；不得写入语义资源"
    },
    "strategy": {
      "enum": ["direct_t2v", "image_guided_i2v", "split_clips"],
      "description": "生产默认关键图先行（image_guided_i2v；多 clip 时 split_clips 并逐 clip 提供关键图）；direct_t2v 是强模型单一连续事件的特例"
    },
    "director_note": {
      "type": "string",
      "description": "简短说明为何选择该策略；不写冗长制片分析"
    },
    "semantic_guardrails": {
      "type": "object",
      "required": ["must_show", "must_avoid"],
      "additionalProperties": false,
      "properties": {
        "must_show": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "must_avoid": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "video_prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "source_beats", "duration_hint", "prompt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^clip-[0-9]{2}$" },
          "source_beats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          },
          "duration_hint": { "type": "number", "minimum": 2, "maximum": 30 },
          "image_prompt": {
            "type": "string",
            "minLength": 20,
            "description": "关键图先行工序下每个 clip 都应提供；仅 direct_t2v 可省略"
          },
          "prompt": {
            "type": "string",
            "minLength": 40,
            "description": "可直接提交给目标视频能力的英文提示词"
          },
          "negative_prompt": { "type": "string" }
        }
      }
    }
  }
}
